{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["clean"],
      "problemMatcher": []
    },
    {
      "label": "compile java",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["compileJava"],
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "compile java --refresh-dependencies",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["compileJava", "--refresh-dependencies"],
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "build",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "stop",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["--stop"],
      "problemMatcher": []
    }
  ]
}
